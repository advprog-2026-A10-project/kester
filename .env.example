# BidMart alpha single-VM deployment environment.
# Copy this file to .env on the VM and replace every CHANGE_ME value.

# Public hostnames. Point these to the VM static external IP in Porkbun.
APP_HOST=bidmart.bid
AUTH_HOST=auth.bidmart.bid
AUTH_API_HOST=api.auth.bidmart.bid
CORE_API_HOST=api.bidmart.bid
ADMIN_API_HOST=admin-api.bidmart.bid

# Public URLs consumed by frontend build args and backend email links.
PUBLIC_APP_URL=https://bidmart.bid
PUBLIC_AUTH_URL=https://auth.bidmart.bid
PUBLIC_AUTH_API_URL=https://api.auth.bidmart.bid
PUBLIC_CORE_API_URL=https://api.bidmart.bid
PUBLIC_ADMIN_API_URL=https://admin-api.bidmart.bid
PUBLIC_BIDDING_WS_URL=wss://ws.bidmart.bid

# Postgres container. Keep this internal to Docker; do not expose it publicly.
POSTGRES_USER=bidmart
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
POSTGRES_DB=postgres
AUTH_DATABASE_NAME=bidmart_auth
CORE_DATABASE_NAME=bidmart_core

# Backend database URLs. These use the internal Docker service name `postgres`.
AUTH_DATABASE_URL=postgres://bidmart:CHANGE_ME_STRONG_DATABASE_PASSWORD@postgres:5432/bidmart_auth
CORE_DATABASE_URL=postgres://bidmart:CHANGE_ME_STRONG_DATABASE_PASSWORD@postgres:5432/bidmart_core

# Auth backend.
APP_ENV=alpha
APP_AUTH_JWT_SECRET=CHANGE_ME_AT_LEAST_32_BYTES_OR_BASE64_32_BYTES
APP_AUTH_MIN_PASSWORD_LENGTH=8
APP_AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
APP_AUTH_VERIFICATION_TOKEN_TTL_SECONDS=900
APP_AUTH_RESEND_COOLDOWN_SECONDS=30
APP_AUTH_PASSWORD_RESET_TOKEN_TTL_SECONDS=900
APP_AUTH_PASSWORD_RESET_COOLDOWN_SECONDS=30
APP_AUTH_MFA_TICKET_TTL_SECONDS=300
APP_AUTH_EMAIL_MFA_CODE_TTL_SECONDS=300
APP_AUTH_EMAIL_MFA_COOLDOWN_SECONDS=30
APP_AUTH_TOTP_SETUP_TTL_SECONDS=600
APP_AUTH_SESSION_COOKIE_NAME=auth_session
APP_AUTH_SESSION_COOKIE_SECURE=true
APP_AUTH_SESSION_COOKIE_SAME_SITE=Lax

# Email delivery. Current Auth BE config still requires a real-looking Resend key
# even for alpha. Put the real key only in the VM .env or GitHub secrets.
APP_EMAIL_DELIVERY_MODE=resend
APP_RESEND_API_KEY=CHANGE_ME_RESEND_SECRET
APP_RESEND_FROM_EMAIL=BidMart <no-reply@auth.bidmart.bid>
APP_VERIFY_EMAIL_URL_BASE=https://auth.bidmart.bid/auth/verify-email?token=
APP_PASSWORD_RESET_URL_BASE=https://auth.bidmart.bid/auth/reset-password?token=
APP_CORS_ALLOWED_ORIGINS=https://bidmart.bid,https://auth.bidmart.bid

# Core backend.
APP_AUTO_MIGRATE_ON_STARTUP=true
APP_BIDDING_FINALIZER_INTERVAL_SECS=5
APP_BIDDING_FINALIZER_BATCH_SIZE=25

# Frontend build/runtime.
VITE_ALLOWED_REDIRECT_ORIGINS=https://bidmart.bid

